{
  "name": "@lumine-code/jasmine-focused",
  "version": "2.0.0",
  "description": "Adds priority-based focused specs to the legacy Jasmine runner used by Lumine.",
  "main": "./lib/jasmine-focused.js",
  "bin": {
    "jasmine-focused": "./bin/jasmine-focused",
    "nof": "./bin/nof"
  },
  "license": "MIT",
  "repository": "https://github.com/lumine-code/jasmine-focused",
  "bugs": "https://github.com/lumine-code/jasmine-focused/issues",
  "homepage": "https://github.com/lumine-code/jasmine-focused/",
  "author": "lumine-code",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "lib"
  ],
  "scripts": {
    "build": "coffee --compile --output lib src",
    "pretest": "npm run build",
    "test": "node node_modules/@lumine-code/jasmine-node/bin/jasmine-node --captureExceptions --coffee spec/",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "coffeescript": "2.7.0"
  },
  "dependencies": {
    "@lumine-code/jasmine-node": "https://github.com/lumine-code/jasmine-node.git#2a8c59b73ce636120e48f707f13bac2832032920",
    "walkdir": "^0.4.1"
  }
}
